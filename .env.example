# Email signup worker endpoint
VITE_EMAIL_WORKER_URL=https://toast-email-worker.jshprintz.workers.dev

# Cloudflare Turnstile site key (public — safe to commit the real value here)
# The value below is the site key.
# This is a placeholder value. Get your own site key from Cloudflare Turnstile and replace it here.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── Analytics ────────────────────────────────────────────────────────
# Set to 1 to require consent before any analytics event is sent. When
# enabled, an unanswered banner counts as a decline, and the choice is
# recorded in the `analytics-consent` cookie which the Pages Function and the
# email worker both read.
#
# Leave at 0 until the consent banner is actually built — turning this on
# without one means no events at all, since absent consent is a decline.
VITE_ANALYTICS_REQUIRE_CONSENT=0

# ── Pages Function environment (NOT Vite) ────────────────────────────
# The variables below are read by functions/api/analytics/event.ts at runtime
# and are NOT part of the client bundle, so they carry no VITE_ prefix. Set
# them in the Cloudflare dashboard under Workers & Pages > toast-byte-studios
# > Settings > Environment variables. They are listed here for documentation
# only; adding them to a local .env does nothing.
#
#   ANALYTICS_GA4_MEASUREMENT_ID   the G-XXXXXXXXXX from the data stream
#   ANALYTICS_GA4_API_SECRET       encrypt this one — it is a credential
#   ANALYTICS_REQUIRE_CONSENT      mirror of VITE_ANALYTICS_REQUIRE_CONSENT
#
# The API secret is NOT the gtag.js snippet. Create one under
# GA4 Admin > Data streams > (stream) > Measurement Protocol API secrets.
# If either value is missing the endpoint returns ok without delivering,
# which is the intended state until they are provisioned.
#
# This endpoint is only a fallback for visitors whose browser did not load
# Zaraz. Zaraz is enabled on this zone and handles the normal path.

# Email signup worker endpoint
# Copy this file to .env.local and fill in the appropriate URL for your environment.
# .env.local is gitignored (matched by .env.*) — never commit real values.
VITE_EMAIL_WORKER_URL=https://toast-email-worker.jshprintz.workers.dev

# Cloudflare Turnstile site key (public — safe to commit the real value here)
# The value below is the site key.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAACkjqZ9GO5WoaAto

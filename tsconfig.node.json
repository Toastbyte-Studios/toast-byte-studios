{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  /*
   * The build-time prerender plugin reads the same route metadata the app
   * does. Because this is a referenced project, every file it pulls in has to
   * be listed here as well or tsc reports TS6307. src/data and src/types are
   * plain data and types with no DOM dependency, so they type-check fine
   * under this project's ES2023-only lib.
   */
  "include": [
    "vite.config.ts",
    "plugins/**/*.ts",
    "src/data/**/*.ts",
    "src/types/**/*.ts"
  ]
}

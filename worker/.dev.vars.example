# Wrangler local development secrets
# Copy this file to .dev.vars and fill in real values.
# .dev.vars is gitignored — never commit real values.
#
# For production, set secrets with:
#   wrangler secret put SECRET_NAME
# (values are stored encrypted in Cloudflare, never in this repo)

# Cloudflare Turnstile secret key
# Get yours at: https://dash.cloudflare.com/ > Turnstile
# The value below is Cloudflare's test secret (always passes, for local dev only).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
